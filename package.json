{
  "name": "dsh-kylin-notifier",
  "version": "1.3.1",
  "description": "银河麒麟桌面消息提醒：对话完成或需要你确认时弹出系统通知，点击通知即可打开并定位到对应对话。",
  "license": "MIT",
  "author": "xingsheng6",
  "homepage": "https://github.com/xingsheng6/dsh-kylin-notifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingsheng6/dsh-kylin-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/xingsheng6/dsh-kylin-notifier/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "notification",
    "notify",
    "kylin",
    "银河麒麟",
    "信创",
    "桌面通知",
    "dbus"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "bridge/notify_bridge.py",
    "bridge/toast_window.py",
    "fonts/*.ttf",
    "fonts/README.md",
    "assets/*.svg",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "fonts/OFL-1.1.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
